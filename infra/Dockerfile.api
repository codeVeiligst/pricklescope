# PrickleScope API: Fastify, reconcilers, and the job runner.
#
# Built from source in one stage and run from the same base in the next, so the
# native Argon2 binding is compiled against the musl libc it will run on.
#
# The runtime stage carries a `pnpm deploy` tree: the API's build output plus only
# the packages it requires, with the local packages copied in rather than linked.

FROM node:24.19.0-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS build

ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
# pnpm refuses to purge a modules directory without a TTY unless it knows it is
# running unattended.
ENV CI=true
WORKDIR /app

RUN corepack enable

# Manifests first, so a source-only change reuses the install layer.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/db/package.json packages/db/
COPY packages/adapters/package.json packages/adapters/
COPY packages/ui/package.json packages/ui/

# `minimumReleaseAge` in pnpm-workspace.yaml needs the registry's publish dates,
# which a frozen lockfile install does not require. Turning it off here keeps the
# build reproducible from the lockfile alone.
RUN corepack pnpm install --frozen-lockfile --config.minimumReleaseAge=0

COPY tsconfig.base.json ./
COPY packages packages
COPY apps/api apps/api

RUN corepack pnpm --filter @pricklescope/contracts \
      --filter @pricklescope/db \
      --filter @pricklescope/adapters \
      --filter @pricklescope/api \
      --workspace-concurrency=1 run build

# A self-contained tree holding only what the API loads at runtime.
#
# `injectWorkspacePackages` is passed here and not on the install: it makes deploy
# copy the local packages instead of linking them. Without it the tree links to
# ../../packages/*, which the runtime stage does not have — the image builds, the
# packages appear in `ls`, and Node resolves none of them. That only surfaced when
# a container was started; building and scanning the image did not show it.
#
# Setting it on the install instead conflicts with --frozen-lockfile, and
# dereferencing the links afterwards with `cp -RL` flattens pnpm's virtual store
# and loses the transitive graph.
RUN corepack pnpm --filter @pricklescope/api --prod \
      --config.injectWorkspacePackages=true deploy /deploy

FROM node:24.19.0-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS runtime

ENV NODE_ENV=production
ENV PRICKLESCOPE_NODE_ENV=production
WORKDIR /app

# Rendered Telegraf configuration is written mode 0600, so Telegraf can only read
# it if it runs as the same user. Both containers take their uid from the same
# variable in the production overlay.
RUN apk add --no-cache tini

COPY --from=build /deploy /app

# The TypeScript sources and tests are not executed; only dist/ is.
#
# npm goes too. The container runs `node dist/server.js` and nothing else, but the
# base image's bundled npm brings its own vendored tar, undici, ip-address, and
# brace-expansion — which were every single advisory a scan reported against this
# image, none of them in code that can run here.
RUN rm -rf /app/src /app/tests /app/tsconfig.json \
      /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

EXPOSE 3001

# The API serves its own liveness probe; readiness is checked by the gateway.
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PRICKLESCOPE_API_PORT||3001)+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/server.js"]
