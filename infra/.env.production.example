# Production values. Copy to infra/.env.production and change every password.
#
#   docker compose --env-file infra/.env.production \
#     -f infra/compose.yaml -f infra/compose.production.yaml up -d --build
#
# Two secrets are files rather than variables, because an environment variable is
# readable from `docker inspect` and from every process in the container: the
# credential encryption key and the bootstrap administrator password. Create them
# before the first start — see infra/README.md.

COMPOSE_PROJECT_NAME=pricklescope

# The public HTTPS origin. PRICKLESCOPE_SITE_ADDRESS is the name Caddy serves and
# obtains a certificate for; PRICKLESCOPE_APP_ORIGIN is the same name as a URL and
# is what the API matches request origins against. They must agree.
#
# The site address alone decides TLS — Caddy has no separate switch. A hostname
# gets a public ACME certificate, `localhost` gets one from Caddy's local CA, and
# a bare `:80` serves plain HTTP for when TLS is terminated somewhere else.
PRICKLESCOPE_SITE_ADDRESS=pricklescope.example.com
PRICKLESCOPE_APP_ORIGIN=https://pricklescope.example.com
PRICKLESCOPE_HTTP_PORT=80
PRICKLESCOPE_HTTPS_PORT=443

# Where the application images come from, and which version.
#
# Uncommented, PRICKLESCOPE_IMAGE_PREFIX runs the released images from the
# project registry — start with `./scripts/prod-up.sh --no-build` and they are
# pulled. Left commented, the images are built from this checkout under a local
# name. The version is reported by the API and shown in the interface, so a
# value that matches nothing published is worse than no value: this example
# used to ship 1.0.0, and a clean install of 0.1.0 called itself 1.0.0.
#PRICKLESCOPE_IMAGE_PREFIX=ghcr.io/codeveiligst/pricklescope
PRICKLESCOPE_VERSION=0.1.1
PRICKLESCOPE_AUTO_MIGRATE=true
PRICKLESCOPE_CREDENTIAL_KEY_VERSION=1
PRICKLESCOPE_BOOTSTRAP_ADMIN_USERNAME=admin
PRICKLESCOPE_BOOTSTRAP_ADMIN_DISPLAY_NAME=PrickleScope Administrator

# Host directory mounted read-only at /run/secrets. It must contain
# `credential_key` and `bootstrap_admin_password`, owned by TELEGRAF_UID below and
# mode 0400 — the API container does not run as root and cannot read root's files.
PRICKLESCOPE_SECRETS_DIR=./secrets

POSTGRES_DB=pricklescope
POSTGRES_TEST_DB=pricklescope_test
POSTGRES_USER=pricklescope
POSTGRES_PASSWORD=change-me-postgres

QUESTDB_CONTROLLER_USER=pricklescope_controller
QUESTDB_CONTROLLER_PASSWORD=change-me-questdb-controller
QUESTDB_GRAFANA_USER=grafana
QUESTDB_GRAFANA_PASSWORD=change-me-questdb-grafana

# The API writes Telegraf's configuration mode 0600 and Telegraf reads it, so both
# containers run as this account. It must own infra/runtime/telegraf on the host.
TELEGRAF_UID=1000
TELEGRAF_GID=1000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Grafana accepts Auth Proxy identity headers only from the Compose network, which
# is where the API sits. Nothing else can reach it: it is not published.
GRAFANA_AUTH_PROXY_WHITELIST=172.16.0.0/12
