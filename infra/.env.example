# Development-only values. Copy to infra/.env and do not reuse in production.
COMPOSE_PROJECT_NAME=pricklescope-dev

POSTGRES_DB=pricklescope
POSTGRES_TEST_DB=pricklescope_test
POSTGRES_USER=pricklescope
POSTGRES_PASSWORD=pricklescope-postgres-dev-only
POSTGRES_PORT=5432

QUESTDB_HTTP_PORT=9000
QUESTDB_PG_PORT=8812
QUESTDB_HEALTH_PORT=9003
QUESTDB_CONTROLLER_USER=pricklescope_controller
QUESTDB_CONTROLLER_PASSWORD=pricklescope-questdb-controller-dev-only
QUESTDB_GRAFANA_USER=grafana
QUESTDB_GRAFANA_PASSWORD=pricklescope-questdb-grafana-dev-only

TELEGRAF_REMOTE_WRITE_PORT=1234
# Match the host account that writes permission-restricted managed revisions.
TELEGRAF_UID=1000
TELEGRAF_GID=1000

GRAFANA_HTTP_PORT=3000
GRAFANA_PUBLIC_ROOT_URL=http://localhost:5173/grafana/
GRAFANA_AUTH_PROXY_WHITELIST=127.0.0.1,172.16.0.0/12
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=pricklescope-grafana-dev-only

