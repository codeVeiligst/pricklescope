# PrickleScope application development settings.
# Copy to .env. Values below are for loopback-only development.
PRICKLESCOPE_NODE_ENV=development
# Bound beyond loopback so Grafana, which runs in a container, can hand email
# notifications back to the controller (D-023). Development only.
PRICKLESCOPE_HOST=0.0.0.0
PRICKLESCOPE_API_PORT=3001
PRICKLESCOPE_APP_ORIGIN=http://localhost:5173
PRICKLESCOPE_DATABASE_URL=postgresql://pricklescope:pricklescope-postgres-dev-only@localhost:5432/pricklescope
TEST_DATABASE_URL=postgresql://pricklescope:pricklescope-postgres-dev-only@localhost:5432/pricklescope_test

PRICKLESCOPE_BOOTSTRAP_ADMIN_USERNAME=admin
PRICKLESCOPE_BOOTSTRAP_ADMIN_PASSWORD=pricklescope-admin-dev-only
PRICKLESCOPE_BOOTSTRAP_ADMIN_DISPLAY_NAME=PrickleScope Administrator

PRICKLESCOPE_SESSION_TTL_SECONDS=28800
PRICKLESCOPE_COOKIE_SECURE=false
PRICKLESCOPE_TRUST_PROXY=false
PRICKLESCOPE_AUTO_MIGRATE=true
PRICKLESCOPE_RUN_JOBS=true

# Exactly 32 bytes encoded as base64. Back up this key separately from PostgreSQL:
# without it every stored credential stays encrypted forever.
#
# Deliberately not a working value. An example key in a committed file is a key
# everyone has, and copying this file is how a .env gets made — so a real one here
# would end up protecting a production installation with a published secret. The
# API refuses to start in production if it finds this placeholder.
# Generate one with:  openssl rand -base64 32
PRICKLESCOPE_CREDENTIAL_KEY=REPLACE_WITH_openssl_rand_base64_32
PRICKLESCOPE_CREDENTIAL_KEY_VERSION=1

PRICKLESCOPE_QUESTDB_HEALTH_URL=http://localhost:9003/
PRICKLESCOPE_QUESTDB_DATABASE_URL=postgresql://pricklescope_controller:pricklescope-questdb-controller-dev-only@localhost:8812/qdb
PRICKLESCOPE_QUESTDB_STATEMENT_TIMEOUT_MS=5000
PRICKLESCOPE_QUESTDB_QUERY_LIMIT=500
PRICKLESCOPE_GRAFANA_HEALTH_URL=http://localhost:3000/grafana/api/health
PRICKLESCOPE_GRAFANA_URL=http://localhost:3000/grafana/
# Bootstrap-only access used to create the organization-scoped service account.
PRICKLESCOPE_GRAFANA_ADMIN_USER=admin
PRICKLESCOPE_GRAFANA_ADMIN_PASSWORD=pricklescope-grafana-dev-only
PRICKLESCOPE_GRAFANA_QUESTDB_SERVER=questdb
PRICKLESCOPE_GRAFANA_QUESTDB_PORT=8812
PRICKLESCOPE_GRAFANA_QUESTDB_USER=grafana
PRICKLESCOPE_GRAFANA_QUESTDB_PASSWORD=pricklescope-questdb-grafana-dev-only
# Where Grafana reaches this API to hand an email notification back for delivery.
# It is resolved inside the Grafana container, so it is not the browser's URL.
PRICKLESCOPE_NOTIFY_BASE_URL=http://host.docker.internal:3001
PRICKLESCOPE_TELEGRAF_HOST=localhost
PRICKLESCOPE_TELEGRAF_PORT=1234

VITE_API_PROXY_TARGET=http://localhost:3001
