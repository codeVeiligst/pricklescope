# Anything holding a real credential. The examples are the only committed form.
.env
.env.*
!.env.example
infra/.env
infra/.env.*
!infra/.env.example
!infra/.env.production.example
infra/compose.override.yaml

# The credential encryption key and the bootstrap password, as files.
infra/secrets/*
!infra/secrets/.gitkeep

# Rendered collector configuration. Written 0600 with SNMP credentials injected,
# regenerated by a reconcile, and never edited by hand — see docs/architecture.md.
#
# The directories themselves are kept. Compose bind-mounts this path into
# Telegraf, and if it does not exist Docker creates it owned by root — which
# breaks the shared uid the 0600 files depend on.
infra/runtime/telegraf/active/*
infra/runtime/telegraf/revisions/*
!infra/runtime/telegraf/active/.gitkeep
!infra/runtime/telegraf/revisions/.gitkeep
infra/runtime-prodtest/

# Private keys and certificates, wherever they land.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Backups and database dumps. ./infra/backup.sh writes outside the repository,
# but a mistyped path should not become a commit.
*.dump
*.sql.gz
backups/

# Generated software bill of materials. Regenerate with ./scripts/sbom.sh; a
# release attaches freshly generated documents rather than committing ones that
# go stale the moment a pin moves.
sbom/

# Installed, built, and test output.
node_modules/
.pnpm-store/
dist/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
*.log

# Local editor and operating-system files.
.DS_Store
.idea/
.vscode/

# AI
CLAUDE.md
